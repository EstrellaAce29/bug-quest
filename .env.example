# Copy to .env.local and fill in locally. Never commit the real key.
OPENAI_API_KEY=
# Optional server-side model override; the default supports structured output.
OPENAI_MODEL=gpt-6-luna

# Real Airflow: use local-only credentials. Never commit .env.local.
AIRFLOW_URL=http://localhost:8081
AIRFLOW_PORT=8081
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=
PGPASSWORD=
PGDATABASE=

# Play-only model selection. /quest keeps its existing OpenAI behavior.
PLAY_MODEL_PROVIDER=openai
# Optional; defaults to OPENAI_MODEL for OpenAI, OLLAMA_MODEL for Ollama.
PLAY_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Kane browsers run headlessly unless Watch Kane is enabled for a quest demo.
KANE_HEADLESS=true
